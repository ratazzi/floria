#!/bin/bash
set -euo pipefail

VERSION="$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/')"
BUILD_NUMBER="${BUILD_NUMBER:-$(date +%Y%m%d%H%M)}"
SIGN_IDENTITY="${SIGN_IDENTITY:--}"
APP_NAME="Floria"
APP_BUNDLE="app/.build/${APP_NAME}.app"
BACKGROUND_IMAGE="app/Assets/DmgBackground.png"
OUTPUT_DMG="${OUTPUT_DMG:-build/${APP_NAME}-${VERSION}.dmg}"
OUTPUT_DIRECTORY="$(dirname "${OUTPUT_DMG}")"
OUTPUT_BASENAME="$(basename "${OUTPUT_DMG}")"
PARTIAL_DMG="${OUTPUT_DIRECTORY}/.${OUTPUT_BASENAME}.partial.$$.dmg"
WRITABLE_DMG="${OUTPUT_DIRECTORY}/.${OUTPUT_BASENAME}.writable.$$.dmg"
STAGING_DIRECTORY="$(mktemp -d "${TMPDIR:-/private/tmp}/floria-dmg-stage.XXXXXX")"
MOUNT_DIRECTORY="$(mktemp -d "${TMPDIR:-/private/tmp}/floria-dmg-mount.XXXXXX")"
FINDER_DISK_NAME="$(basename "${MOUNT_DIRECTORY}")"
MOUNTED=0

cleanup() {
    local cleanup_status=$?
    trap - EXIT INT TERM
    if ((MOUNTED == 1)); then
        if hdiutil detach "${MOUNT_DIRECTORY}" -quiet; then
            MOUNTED=0
        else
            echo "Could not detach DMG verification mount: ${MOUNT_DIRECTORY}" >&2
        fi
    fi
    rm -rf "${STAGING_DIRECTORY}"
    if ((MOUNTED == 0)); then
        rm -rf "${MOUNT_DIRECTORY}"
        rm -f "${PARTIAL_DMG}" "${WRITABLE_DMG}"
    else
        echo "Preserving the partial image and mount directory for safe manual cleanup." >&2
    fi
    exit "${cleanup_status}"
}
trap cleanup EXIT INT TERM

if [[ -e "${OUTPUT_DMG}" ]]; then
    echo "Refusing to overwrite existing DMG: ${OUTPUT_DMG}" >&2
    exit 1
fi
if [[ ! -f "${BACKGROUND_IMAGE}" ]]; then
    echo "DMG background is missing: ${BACKGROUND_IMAGE}; run mise run generate-dmg-background" >&2
    exit 1
fi

mkdir -p "${OUTPUT_DIRECTORY}"
BUILD_NUMBER="${BUILD_NUMBER}" SIGN_IDENTITY="${SIGN_IDENTITY}" scripts/build-app

echo "==> Staging ${APP_NAME}.app"
ditto "${APP_BUNDLE}" "${STAGING_DIRECTORY}/${APP_NAME}.app"
ln -s /Applications "${STAGING_DIRECTORY}/Applications"
mkdir "${STAGING_DIRECTORY}/.background"
cp "${BACKGROUND_IMAGE}" "${STAGING_DIRECTORY}/.background/DmgBackground.png"

echo "==> Creating writable installer layout"
hdiutil create \
    -volname "${APP_NAME}" \
    -srcfolder "${STAGING_DIRECTORY}" \
    -format UDRW \
    -fs HFS+ \
    "${WRITABLE_DMG}" >/dev/null
hdiutil attach \
    -readwrite \
    -noverify \
    -noautoopen \
    -mountpoint "${MOUNT_DIRECTORY}" \
    "${WRITABLE_DMG}" >/dev/null
MOUNTED=1
chflags hidden "${MOUNT_DIRECTORY}/.background"

/usr/bin/osascript <<APPLESCRIPT
tell application "Finder"
    -- A custom hdiutil mountpoint is exposed to Finder by the mountpoint's
    -- basename, even though the filesystem volume name remains Floria.
    tell disk "${FINDER_DISK_NAME}"
        open
        set current view of container window to icon view
        set toolbar visible of container window to false
        set statusbar visible of container window to false
        set pathbar visible of container window to false
        set the bounds of container window to {120, 120, 780, 540}
        set viewOptions to the icon view options of container window
        set arrangement of viewOptions to not arranged
        set icon size of viewOptions to 96
        set text size of viewOptions to 13
        set background picture of viewOptions to file ".background:DmgBackground.png"
        set position of item "${APP_NAME}.app" of container window to {180, 235}
        set position of item "Applications" of container window to {480, 235}
        update without registering applications
        delay 1
        close
    end tell
end tell
APPLESCRIPT

sync
hdiutil detach "${MOUNT_DIRECTORY}" -quiet
MOUNTED=0

echo "==> Compressing ${OUTPUT_DMG}"
hdiutil convert \
    "${WRITABLE_DMG}" \
    -format UDZO \
    -imagekey zlib-level=9 \
    -o "${PARTIAL_DMG}" >/dev/null
rm -f "${WRITABLE_DMG}"

if [[ "${SIGN_IDENTITY}" != "-" ]]; then
    echo "==> Signing DMG"
    codesign --force --sign "${SIGN_IDENTITY}" --timestamp "${PARTIAL_DMG}"
    codesign --verify --strict "${PARTIAL_DMG}"
fi

echo "==> Verifying DMG contents"
hdiutil verify "${PARTIAL_DMG}" >/dev/null
hdiutil attach \
    -readonly \
    -nobrowse \
    -mountpoint "${MOUNT_DIRECTORY}" \
    "${PARTIAL_DMG}" >/dev/null
MOUNTED=1

MOUNTED_APP="${MOUNT_DIRECTORY}/${APP_NAME}.app"
MOUNTED_BUNDLE_IDENTIFIER="$(
    /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "${MOUNTED_APP}/Contents/Info.plist"
)"
if [[ "$(readlink "${MOUNT_DIRECTORY}/Applications")" != "/Applications" ]]; then
    echo "DMG Applications link does not point to /Applications" >&2
    exit 1
fi
if [[ ! -f "${MOUNT_DIRECTORY}/.background/DmgBackground.png" ]] ||
    [[ ! -f "${MOUNT_DIRECTORY}/.DS_Store" ]]; then
    echo "DMG visual layout metadata is incomplete" >&2
    exit 1
fi
if [[ "${MOUNTED_BUNDLE_IDENTIFIER}" != "floria.hola.ac" ]]; then
    echo "DMG app has the wrong bundle identifier" >&2
    exit 1
fi
codesign --verify --deep --strict "${MOUNTED_APP}"
# scripts/build-app already executes the packaged daemon before creating the
# image. Running an unnotarized Developer ID helper directly from a read-only
# DMG can block in Gatekeeper evaluation, so mounted-image verification stays
# byte- and signature-based here.

hdiutil detach "${MOUNT_DIRECTORY}" -quiet
MOUNTED=0
mv "${PARTIAL_DMG}" "${OUTPUT_DMG}"

echo "==> DMG: ${OUTPUT_DMG}"
