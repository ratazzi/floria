#!/bin/bash
set -euo pipefail

EXPECTED_TEAM_ID="${FLORIA_SIGNING_TEAM_ID:?FLORIA_SIGNING_TEAM_ID is required}"
EXPECTED_BUNDLE_ID="floria.hola.ac"
EXPECTED_CONTAINER_ID="iCloud.floria.hola.ac"
WORK_DIRECTORY="$(mktemp -d "${TMPDIR:-/private/tmp}/floria-cloudkit-signing.XXXXXX")"

cleanup() {
    rm -rf "${WORK_DIRECTORY}"
}
trap cleanup EXIT INT TERM

fail() {
    echo "CloudKit signing verification failed: $*" >&2
    exit 1
}

plist_value() {
    /usr/libexec/PlistBuddy -c "Print :$2" "$1" 2>/dev/null || true
}

plist_array_contains() {
    local plist="$1"
    local key="$2"
    local expected="$3"
    local values
    values="$(plist_value "${plist}" "${key}")"
    grep -Fxq "    ${expected}" <<<"${values}"
}

entitlement_abstract_contains() {
    local entitlements="$1"
    local key="$2"
    local expected="$3"
    awk -v expected_key="${key}" -v expected_value="${expected}" '
        /^[[:space:]]*\[Key\][[:space:]]+/ {
            key = $0
            sub(/^[[:space:]]*\[Key\][[:space:]]+/, "", key)
            selected = key == expected_key
            next
        }
        selected && /^[[:space:]]*\[String\][[:space:]]+/ {
            value = $0
            sub(/^[[:space:]]*\[String\][[:space:]]+/, "", value)
            if (value == expected_value) {
                found = 1
            }
        }
        END { exit found ? 0 : 1 }
    ' "${entitlements}"
}

case "${1:-}" in
    --profile)
        [[ $# -eq 2 ]] || fail "usage: scripts/verify-cloudkit-signing --profile /path/to/profile"
        APP_BUNDLE=""
        PROFILE_PATH="$2"
        ;;
    --app)
        [[ $# -eq 2 ]] || fail "usage: scripts/verify-cloudkit-signing --app /path/to/Floria.app"
        APP_BUNDLE="$2"
        PROFILE_PATH="${APP_BUNDLE}/Contents/embedded.provisionprofile"
        [[ -d "${APP_BUNDLE}" ]] || fail "app bundle does not exist: ${APP_BUNDLE}"
        ;;
    *)
        fail "usage: scripts/verify-cloudkit-signing (--profile /path/to/profile | --app /path/to/Floria.app)"
        ;;
esac

[[ -f "${PROFILE_PATH}" ]] || fail "provisioning profile is missing: ${PROFILE_PATH}"

PROFILE_PLIST="${WORK_DIRECTORY}/profile.plist"
security cms -D -i "${PROFILE_PATH}" >"${PROFILE_PLIST}" ||
    fail "embedded provisioning profile cannot be decoded"

PROFILE_APP_ID="$(plist_value "${PROFILE_PLIST}" "Entitlements:com.apple.application-identifier")"
PROFILE_TEAM_ID="$(plist_value "${PROFILE_PLIST}" "Entitlements:com.apple.developer.team-identifier")"
PROFILE_ENVIRONMENT="$(plist_value "${PROFILE_PLIST}" "Entitlements:com.apple.developer.icloud-container-environment")"

[[ "${PROFILE_APP_ID}" == "${EXPECTED_TEAM_ID}.${EXPECTED_BUNDLE_ID}" ]] ||
    fail "profile application identifier is ${PROFILE_APP_ID:-missing}; expected ${EXPECTED_TEAM_ID}.${EXPECTED_BUNDLE_ID}"
[[ "${PROFILE_TEAM_ID}" == "${EXPECTED_TEAM_ID}" ]] ||
    fail "profile Team ID is ${PROFILE_TEAM_ID:-missing}; expected ${EXPECTED_TEAM_ID}"
[[ "${PROFILE_ENVIRONMENT}" == "Production" ]] ||
    fail "profile CloudKit environment is ${PROFILE_ENVIRONMENT:-missing}; expected Production"
plist_array_contains \
    "${PROFILE_PLIST}" \
    "Entitlements:com.apple.developer.icloud-container-identifiers" \
    "${EXPECTED_CONTAINER_ID}" ||
    fail "profile does not authorize ${EXPECTED_CONTAINER_ID}"
plist_array_contains \
    "${PROFILE_PLIST}" \
    "Entitlements:com.apple.developer.icloud-services" \
    "CloudKit" ||
    [[ "$(plist_value "${PROFILE_PLIST}" "Entitlements:com.apple.developer.icloud-services")" == "*" ]] ||
    fail "profile does not authorize CloudKit"

if [[ -z "${APP_BUNDLE}" ]]; then
    echo "==> Verified CloudKit provisioning profile for ${EXPECTED_BUNDLE_ID} (${EXPECTED_CONTAINER_ID})"
    exit 0
fi

SIGNED_ENTITLEMENTS="${WORK_DIRECTORY}/signed-entitlements.abstract"
codesign -d --entitlements "${SIGNED_ENTITLEMENTS}" "${APP_BUNDLE}" 2>/dev/null ||
    fail "app entitlements cannot be read"
entitlement_abstract_contains \
    "${SIGNED_ENTITLEMENTS}" \
    "com.apple.application-identifier" \
    "${EXPECTED_TEAM_ID}.${EXPECTED_BUNDLE_ID}" ||
    fail "signed app has the wrong application identifier"
entitlement_abstract_contains \
    "${SIGNED_ENTITLEMENTS}" \
    "com.apple.developer.team-identifier" \
    "${EXPECTED_TEAM_ID}" ||
    fail "signed app has the wrong Team ID"
entitlement_abstract_contains \
    "${SIGNED_ENTITLEMENTS}" \
    "com.apple.developer.icloud-container-environment" \
    "Production" ||
    fail "signed app does not claim the Production CloudKit environment"
entitlement_abstract_contains \
    "${SIGNED_ENTITLEMENTS}" \
    "com.apple.developer.icloud-container-identifiers" \
    "${EXPECTED_CONTAINER_ID}" ||
    fail "signed app does not claim ${EXPECTED_CONTAINER_ID}"
entitlement_abstract_contains \
    "${SIGNED_ENTITLEMENTS}" \
    "com.apple.developer.icloud-services" \
    "CloudKit" ||
    fail "signed app does not claim CloudKit"

echo "==> Verified CloudKit signing for ${EXPECTED_BUNDLE_ID} (${EXPECTED_CONTAINER_ID})"
