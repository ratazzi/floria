#!/bin/bash
set -euo pipefail

VERSION="$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/')"
BUILD_NUMBER="${BUILD_NUMBER:-$(date +%Y%m%d%H%M)}"
INSTALL_VARIANT="${FLORIA_INSTALL_VARIANT:-cloudkit}"
SIGN_IDENTITY="${SIGN_IDENTITY:-}"
FLORIA_SIGNING_TEAM_ID="${FLORIA_SIGNING_TEAM_ID:-}"
FLORIA_APP_PROVISIONING_PROFILE="${FLORIA_APP_PROVISIONING_PROFILE:-}"
APP_NAME="Floria"
APP_BUNDLE="app/.build/${APP_NAME}.app"
INSTALL_DIR="${INSTALL_DIR:-/Applications}"
INSTALLED_APP="${INSTALL_DIR}/${APP_NAME}.app"
INSTALLED_DAEMON="${INSTALLED_APP}/Contents/Resources/floria"
INFO_PLIST="${INSTALLED_APP}/Contents/Info.plist"
BUILT_INFO_PLIST="${APP_BUNDLE}/Contents/Info.plist"
RUNTIME_DIRECTORY="${HOME}/Library/Application Support/floria"
CONFIG_PATH="${RUNTIME_DIRECTORY}/floria.toml"
SERVICE_LABEL="floria.hola.ac.daemon"
SERVICE_TARGET="gui/$(id -u)/${SERVICE_LABEL}"
LAUNCH_AGENT_PLIST="${HOME}/Library/LaunchAgents/${SERVICE_LABEL}.plist"
LEGACY_SERVICE_LABEL="dev.floria.hola.ac.daemon"
LEGACY_SERVICE_TARGET="gui/$(id -u)/${LEGACY_SERVICE_LABEL}"
LEGACY_LAUNCH_AGENT_PLIST="${HOME}/Library/LaunchAgents/${LEGACY_SERVICE_LABEL}.plist"
WAIT_SECONDS="${FLORIA_INSTALL_WAIT_SECONDS:-20}"
DAEMON_WAIT_SECONDS="${FLORIA_INSTALL_DAEMON_WAIT_SECONDS:-60}"
EXPECTED_REVISION="${VERSION}+${BUILD_NUMBER}"
ALLOW_CLOUDKIT_DOWNGRADE="${FLORIA_ALLOW_CLOUDKIT_DOWNGRADE:-0}"

configure_signing() {
    local profile_plist
    local profile_team_id
    local identities

    case "${INSTALL_VARIANT}" in
        cloudkit)
            if [[ -z "${FLORIA_APP_PROVISIONING_PROFILE}" ]]; then
                FLORIA_APP_PROVISIONING_PROFILE="${HOME}/Downloads/Floria_Developer_ID_Production.provisionprofile"
            fi
            if [[ ! -f "${FLORIA_APP_PROVISIONING_PROFILE}" ]]; then
                echo "CloudKit provisioning profile not found: ${FLORIA_APP_PROVISIONING_PROFILE}" >&2
                echo "Set FLORIA_APP_PROVISIONING_PROFILE to the production profile for floria.hola.ac." >&2
                return 1
            fi

            profile_plist="$(mktemp "${TMPDIR:-/private/tmp}/floria-install-profile.XXXXXX")"
            if ! security cms -D -i "${FLORIA_APP_PROVISIONING_PROFILE}" >"${profile_plist}"; then
                rm -f "${profile_plist}"
                echo "Cannot decode CloudKit provisioning profile: ${FLORIA_APP_PROVISIONING_PROFILE}" >&2
                return 1
            fi
            profile_team_id="$(
                /usr/libexec/PlistBuddy \
                    -c 'Print :Entitlements:com.apple.developer.team-identifier' \
                    "${profile_plist}" 2>/dev/null || true
            )"
            rm -f "${profile_plist}"
            if [[ ! "${profile_team_id}" =~ ^[A-Z0-9]{10}$ ]]; then
                echo "CloudKit provisioning profile has no valid Apple Team ID." >&2
                return 1
            fi
            if [[ -n "${FLORIA_SIGNING_TEAM_ID}" &&
                "${FLORIA_SIGNING_TEAM_ID}" != "${profile_team_id}" ]]; then
                echo "FLORIA_SIGNING_TEAM_ID does not match the provisioning profile Team ID." >&2
                return 1
            fi
            FLORIA_SIGNING_TEAM_ID="${profile_team_id}"

            if [[ -z "${SIGN_IDENTITY}" ]]; then
                identities="$(security find-identity -v -p codesigning 2>/dev/null || true)"
                SIGN_IDENTITY="$(
                    sed -nE \
                        "s/^[[:space:]]*[0-9]+\) [A-F0-9]+ \"(Developer ID Application: .+ \\(${FLORIA_SIGNING_TEAM_ID}\\))\"$/\\1/p" \
                        <<<"${identities}" | head -1
                )"
            fi
            if [[ -z "${SIGN_IDENTITY}" || "${SIGN_IDENTITY}" == "-" ]]; then
                echo "No Developer ID Application identity found for Team ${FLORIA_SIGNING_TEAM_ID}." >&2
                echo "Import the certificate and private key, or set SIGN_IDENTITY explicitly." >&2
                return 1
            fi
            ;;
        development)
            SIGN_IDENTITY="-"
            FLORIA_SIGNING_TEAM_ID=""
            FLORIA_APP_PROVISIONING_PROFILE=""
            ;;
        *)
            echo "Unknown FLORIA_INSTALL_VARIANT: ${INSTALL_VARIANT} (expected cloudkit or development)" >&2
            return 1
            ;;
    esac
}

cloudkit_enabled() {
    local info_plist="$1"

    [[ -f "${info_plist}" ]] &&
        [[ "$(plutil -extract FloriaCloudKitEnabled raw "${info_plist}" 2>/dev/null || true)" == "true" ]]
}

cloudkit_downgrade_error() {
    cat >&2 <<'EOF'
Refusing to replace the installed CloudKit-enabled Floria app with an ad-hoc build.

Build with SIGN_IDENTITY, FLORIA_SIGNING_TEAM_ID, and
FLORIA_APP_PROVISIONING_PROFILE to preserve iCloud Sync. If disabling CloudKit is
intentional, rerun with FLORIA_ALLOW_CLOUDKIT_DOWNGRADE=1.
EOF
    return 1
}

preflight_cloudkit_downgrade() {
    if cloudkit_enabled "${INFO_PLIST}" &&
        [[ -z "${FLORIA_APP_PROVISIONING_PROFILE:-}" ]] &&
        [[ "${ALLOW_CLOUDKIT_DOWNGRADE}" != "1" ]]; then
        cloudkit_downgrade_error
    fi
}

refuse_built_cloudkit_downgrade() {
    if cloudkit_enabled "${INFO_PLIST}" &&
        ! cloudkit_enabled "${BUILT_INFO_PLIST}" &&
        [[ "${ALLOW_CLOUDKIT_DOWNGRADE}" != "1" ]]; then
        cloudkit_downgrade_error
    fi
}

wait_for_app_to_stop() {
    local deadline=$((SECONDS + WAIT_SECONDS))

    while ((SECONDS < deadline)); do
        if ! pgrep -x "${APP_NAME}" >/dev/null; then
            return 0
        fi
        sleep 0.25
    done

    echo "Timed out waiting for the previous ${APP_NAME} app to stop" >&2
    return 1
}

stop_installed_daemon() {
    if ! /bin/launchctl print "${SERVICE_TARGET}" >/dev/null 2>&1; then
        return 0
    fi

    echo "==> Stopping previous ${APP_NAME} daemon"
    /bin/launchctl bootout "${SERVICE_TARGET}" >/dev/null 2>&1 || true

    # launchd terminates the process without unwinding Rust's mount session. Detach the exact
    # previous mount before replacing the bundle so the new daemon never inherits a stale volume.
    if [[ -x "${INSTALLED_DAEMON}" && -f "${CONFIG_PATH}" ]]; then
        "${INSTALLED_DAEMON}" unmount --config "${CONFIG_PATH}" >/dev/null 2>&1 || true
    fi
}

start_installed_app() {
    local deadline=$((SECONDS + WAIT_SECONDS))

    while ((SECONDS < deadline)); do
        if pgrep -x "${APP_NAME}" >/dev/null; then
            return 0
        fi

        # LaunchServices can briefly retain the just-terminated instance while the
        # bundle at the same path is being replaced, returning -600 on the first open.
        # Retry the launch instead of treating that transient registration state as
        # an installation failure.
        open -na "${INSTALLED_APP}" >/dev/null 2>&1 || true
        sleep 1
    done

    echo "Timed out waiting for the installed ${APP_NAME} app to start" >&2
    return 1
}

installed_definition_revision() {
    /usr/libexec/PlistBuddy \
        -c "Print :EnvironmentVariables:FLORIA_BUNDLE_REVISION" \
        "${LAUNCH_AGENT_PLIST}" 2>/dev/null || true
}

wait_for_current_daemon() {
    # On a freshly replaced ad-hoc-signed bundle, macOS trust and local integrity checks can
    # legitimately exceed the 20-second process-launch budget before the control socket becomes
    # available. Keep that short budget for app lifecycle operations, but allow daemon readiness
    # a full minute.
    local deadline=$((SECONDS + DAEMON_WAIT_SECONDS))
    local actual_revision=""

    while ((SECONDS < deadline)); do
        actual_revision="$(installed_definition_revision)"
        if [[ "${actual_revision}" == "${EXPECTED_REVISION}" ]] &&
            /bin/launchctl print "${SERVICE_TARGET}" 2>/dev/null |
                grep -q "state = running" &&
            "${INSTALLED_DAEMON}" control --config "${CONFIG_PATH}" ping >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.25
    done

    echo "Timed out waiting for daemon revision ${EXPECTED_REVISION}; found ${actual_revision:-none}" >&2
    /bin/launchctl print "${SERVICE_TARGET}" >&2 || true
    return 1
}

configure_signing
preflight_cloudkit_downgrade
BUILD_NUMBER="${BUILD_NUMBER}" \
    SIGN_IDENTITY="${SIGN_IDENTITY}" \
    FLORIA_SIGNING_TEAM_ID="${FLORIA_SIGNING_TEAM_ID}" \
    FLORIA_APP_PROVISIONING_PROFILE="${FLORIA_APP_PROVISIONING_PROFILE}" \
    scripts/build-app
refuse_built_cloudkit_downgrade

if pgrep -x "${APP_NAME}" >/dev/null; then
    echo "==> Stopping previous ${APP_NAME} app"
    killall "${APP_NAME}"
    wait_for_app_to_stop
fi

# An ad-hoc signature's designated requirement contains its exact cdhash. Reusing a daemon from
# the previous local bundle would therefore reject the newly installed GUI even when two builds
# happen to share the same minute-based bundle revision.
stop_installed_daemon

if /bin/launchctl print "${LEGACY_SERVICE_TARGET}" >/dev/null 2>&1 ||
    [[ -e "${LEGACY_LAUNCH_AGENT_PLIST}" ]]; then
    echo "==> Removing development LaunchAgent ${LEGACY_SERVICE_LABEL}"
    /bin/launchctl bootout "${LEGACY_SERVICE_TARGET}" >/dev/null 2>&1 || true
    rm -f "${LEGACY_LAUNCH_AGENT_PLIST}"
fi

echo "==> Installing ${INSTALLED_APP}"
if [[ -w "${INSTALL_DIR}" ]]; then
    rm -rf "${INSTALLED_APP}"
    ditto "${APP_BUNDLE}" "${INSTALLED_APP}"
else
    sudo rm -rf "${INSTALLED_APP}"
    sudo ditto "${APP_BUNDLE}" "${INSTALLED_APP}"
fi

echo "==> Starting installed ${APP_NAME} app"
start_installed_app

if [[ -d /Library/Filesystems/macfuse.fs ]]; then
    echo "==> Waiting for daemon revision ${EXPECTED_REVISION}"
    wait_for_current_daemon
fi

echo "==> Installed and started: ${INSTALLED_APP}"
