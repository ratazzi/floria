#!/bin/bash
set -euo pipefail

APP_PATH="${FLORIA_APP_PATH:-/Applications/Floria.app}"
APP_NAME="Floria"
DAEMON_PATH="${APP_PATH}/Contents/Resources/floria"
INFO_PLIST="${APP_PATH}/Contents/Info.plist"
RUNTIME_DIRECTORY="${HOME}/Library/Application Support/floria"
CONFIG_PATH="${RUNTIME_DIRECTORY}/floria.toml"
AGENT_SOCKET="${RUNTIME_DIRECTORY}/agent.sock"
CONTROL_SOCKET="${RUNTIME_DIRECTORY}/control.sock"
SERVICE_LABEL="floria.hola.ac.daemon"
SERVICE_TARGET="gui/$(id -u)/${SERVICE_LABEL}"
LAUNCH_AGENT_PLIST="${HOME}/Library/LaunchAgents/${SERVICE_LABEL}.plist"
# Runtime recovery can legitimately span both the old mount process's exit timeout and
# launchd's throttled KeepAlive restart. Keep the default above those two serialized windows.
WAIT_SECONDS="${FLORIA_SMOKE_WAIT_SECONDS:-40}"
READ_FAILURE_SECONDS="${FLORIA_SMOKE_READ_FAILURE_SECONDS:-3}"
CRASH_FIXTURE_DIRECTORY=""
CRASH_FIXTURE_PATH=""
CRASH_FIXTURE_OWNED=0
CRASH_READER_PID=0

for required_path in "${APP_PATH}" "${DAEMON_PATH}" "${INFO_PLIST}" "${CONFIG_PATH}"; do
    if [[ ! -e "${required_path}" ]]; then
        echo "Missing required installed-app path: ${required_path}" >&2
        exit 1
    fi
done

if [[ ! -x "${DAEMON_PATH}" ]]; then
    echo "Installed daemon is not executable: ${DAEMON_PATH}" >&2
    exit 1
fi

app_version="$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "${INFO_PLIST}")"
app_build="$(/usr/libexec/PlistBuddy -c "Print :CFBundleVersion" "${INFO_PLIST}")"
expected_revision="${app_version}+${app_build}"

initial_app_running=0
if pgrep -x "${APP_NAME}" >/dev/null; then
    initial_app_running=1
fi

job_value() {
    local key="$1"
    /bin/launchctl print "${SERVICE_TARGET}" 2>/dev/null |
        awk -v key="${key}" '
            $1 == key && $2 == "=" {
                $1 = ""
                $2 = ""
                sub(/^[[:space:]]+/, "")
                print
                exit
            }
        '
}

job_state() {
    job_value state
}

job_runs() {
    local value
    value="$(job_value runs || true)"
    if [[ "${value}" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "${value}"
    else
        printf '0\n'
    fi
}

job_pid() {
    local value
    value="$(job_value pid || true)"
    if [[ "${value}" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "${value}"
    else
        printf '0\n'
    fi
}

socket_inode() {
    local path="$1"
    stat -f '%i' "${path}" 2>/dev/null || true
}

assert_daemon_owns_socket() {
    local pid="$1"
    local path="$2"
    local deadline=$((SECONDS + WAIT_SECONDS))
    local open_unix_files=""

    while ((SECONDS < deadline)); do
        open_unix_files="$(/usr/sbin/lsof -n -Fn -U -a -p "${pid}" 2>/dev/null || true)"
        if awk -v path="${path}" \
            '$0 == "n" path { found = 1 } END { exit !found }' <<<"${open_unix_files}"; then
            return 0
        fi
        sleep 0.05
    done

    echo "Timed out waiting for daemon ${pid} to own runtime socket ${path}" >&2
    [[ -n "${open_unix_files}" ]] && echo "${open_unix_files}" >&2
    return 1
}

assert_untrusted_socket_rejected() {
    local path="$1"
    local description="$2"

    if ! /bin/zsh -c '
        zmodload zsh/net/socket || exit 91
        zmodload zsh/system || exit 92
        zsocket "$1" || exit 93
        socket_fd=$REPLY
        reply=""
        sysread -i "${socket_fd}" -t 2 -s 1 reply
        read_status=$?
        exec {socket_fd}>&-
        [[ "${read_status}" == "5" && "${#reply}" == "0" ]]
    ' -- "${path}"; then
        echo "Untrusted system shell was not rejected by ${description}: ${path}" >&2
        return 1
    fi
}

wait_for_process_exit() {
    local pid="$1"
    local description="$2"
    local deadline=$((SECONDS + WAIT_SECONDS))

    while ((SECONDS < deadline)); do
        if ! kill -0 "${pid}" 2>/dev/null; then
            return 0
        fi
        sleep 0.25
    done

    echo "Timed out waiting for ${description} (pid ${pid}) to exit" >&2
    return 1
}

wait_for_path() {
    local path="$1"
    local description="$2"
    local wait_seconds="${3:-${WAIT_SECONDS}}"
    local deadline=$((SECONDS + wait_seconds))

    while ((SECONDS < deadline)); do
        if [[ -e "${path}" ]]; then
            return 0
        fi
        sleep 0.01
    done

    echo "Timed out waiting for ${description}" >&2
    return 1
}

wait_for_job_state() {
    local expected="$1"
    local description="$2"
    local deadline=$((SECONDS + WAIT_SECONDS))
    local actual=""

    while ((SECONDS < deadline)); do
        actual="$(job_state || true)"
        if [[ "${actual}" == "${expected}" ]]; then
            return 0
        fi
        sleep 0.25
    done

    echo "Timed out waiting for ${description}; launchd state was '${actual:-unavailable}'" >&2
    /bin/launchctl print "${SERVICE_TARGET}" >&2 || true
    return 1
}

wait_for_job_restart() {
    local runs_before="$1"
    local description="$2"
    local deadline=$((SECONDS + WAIT_SECONDS))
    local actual_state=""
    local actual_runs=0

    while ((SECONDS < deadline)); do
        actual_state="$(job_state || true)"
        actual_runs="$(job_runs)"
        if [[ "${actual_state}" == "running" ]] && ((actual_runs > runs_before)); then
            return 0
        fi
        sleep 0.25
    done

    echo "Timed out waiting for ${description}" >&2
    echo "launchd state='${actual_state:-unavailable}', runs before=${runs_before}, after=${actual_runs}" >&2
    /bin/launchctl print "${SERVICE_TARGET}" >&2 || true
    return 1
}

wait_for_current_definition() {
    local deadline=$((SECONDS + WAIT_SECONDS))
    local actual_program=""
    local actual_revision=""

    while ((SECONDS < deadline)); do
        actual_program="$(
            /usr/libexec/PlistBuddy -c "Print :Program" "${LAUNCH_AGENT_PLIST}" 2>/dev/null || true
        )"
        actual_revision="$(
            /usr/libexec/PlistBuddy \
                -c "Print :EnvironmentVariables:FLORIA_BUNDLE_REVISION" \
                "${LAUNCH_AGENT_PLIST}" 2>/dev/null || true
        )"
        if [[ "${actual_program}" == "${DAEMON_PATH}" ]] &&
            [[ "${actual_revision}" == "${expected_revision}" ]]; then
            return 0
        fi
        sleep 0.25
    done

    echo "Timed out waiting for the installed LaunchAgent definition" >&2
    echo "program expected='${DAEMON_PATH}', actual='${actual_program:-missing}'" >&2
    echo "revision expected='${expected_revision}', actual='${actual_revision:-missing}'" >&2
    return 1
}

wait_for_doctor() {
    local description="$1"
    local deadline=$((SECONDS + WAIT_SECONDS))

    while ((SECONDS < deadline)); do
        if "${DAEMON_PATH}" doctor --config "${CONFIG_PATH}" >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.25
    done

    echo "Timed out waiting for ${description}" >&2
    "${DAEMON_PATH}" doctor --config "${CONFIG_PATH}" >&2 || true
    return 1
}

wait_for_app_state() {
    local expected="$1"
    local deadline=$((SECONDS + WAIT_SECONDS))

    while ((SECONDS < deadline)); do
        if pgrep -x "${APP_NAME}" >/dev/null; then
            [[ "${expected}" == "running" ]] && return 0
        else
            [[ "${expected}" == "stopped" ]] && return 0
        fi
        sleep 0.25
    done

    echo "Timed out waiting for ${APP_NAME} to be ${expected}" >&2
    return 1
}

stop_app() {
    killall "${APP_NAME}" >/dev/null 2>&1 || true
    wait_for_app_state stopped
}

request_app_start() {
    local deadline=$((SECONDS + WAIT_SECONDS))
    local output=""

    while ((SECONDS < deadline)); do
        if output="$(open -na "${APP_PATH}" 2>&1)"; then
            return 0
        fi
        sleep 0.25
    done

    echo "Timed out asking LaunchServices to open ${APP_PATH}" >&2
    [[ -n "${output}" ]] && echo "${output}" >&2
    return 1
}

start_app() {
    request_app_start
    wait_for_app_state running
    wait_for_current_definition
    wait_for_job_state running "the Floria daemon to start"
}

stop_daemon() {
    /bin/launchctl stop "${SERVICE_LABEL}"
    wait_for_job_state "not running" "the Floria daemon to stop"
}

restore_environment() {
    local test_status=$?
    local cleanup_failed=0
    local fixture_cleanup_failed=0
    trap - EXIT INT TERM

    if ((CRASH_READER_PID > 0)) && kill -0 "${CRASH_READER_PID}" 2>/dev/null; then
        kill "${CRASH_READER_PID}" >/dev/null 2>&1 || true
        wait "${CRASH_READER_PID}" >/dev/null 2>&1 || true
    fi

    if [[ "$(job_state || true)" != "running" ]]; then
        request_app_start >/dev/null 2>&1 || true
        wait_for_job_state running "the Floria daemon to recover during cleanup" || true
    fi
    if ! wait_for_doctor "the Floria installation to recover during cleanup"; then
        cleanup_failed=1
    fi

    if ((CRASH_FIXTURE_OWNED != 0)) &&
        [[ -n "${CRASH_FIXTURE_PATH}" && -L "${CRASH_FIXTURE_PATH}" ]]; then
        local unprotect_output=""
        if ! unprotect_output="$(
            "${DAEMON_PATH}" unprotect "${CRASH_FIXTURE_PATH}" \
                --config "${CONFIG_PATH}" 2>&1
        )"; then
            echo "Could not stop protecting crash-test fixture ${CRASH_FIXTURE_PATH}" >&2
            [[ -n "${unprotect_output}" ]] && echo "${unprotect_output}" >&2
            cleanup_failed=1
            fixture_cleanup_failed=1
        fi
    fi
    if [[ -n "${CRASH_FIXTURE_DIRECTORY}" &&
        "${fixture_cleanup_failed}" == "0" &&
        "${CRASH_FIXTURE_DIRECTORY}" == /private/tmp/floria-daemon-crash.* ]]; then
        rm -rf "${CRASH_FIXTURE_DIRECTORY}"
    elif ((fixture_cleanup_failed != 0)); then
        echo "Preserved crash-test fixture for recovery: ${CRASH_FIXTURE_DIRECTORY}" >&2
    fi

    if ((initial_app_running == 0)); then
        killall "${APP_NAME}" >/dev/null 2>&1 || true
    fi

    if ((test_status == 0 && cleanup_failed != 0)); then
        test_status=1
    fi
    exit "${test_status}"
}
trap restore_environment EXIT INT TERM

echo "==> Establishing installed-app baseline"
wait_for_current_definition
wait_for_job_state running "install-app to start the current Floria daemon"
wait_for_doctor "the installed Floria app to become healthy"
"${DAEMON_PATH}" doctor --config "${CONFIG_PATH}"

echo "==> Verifying local socket code-signing policy"
assert_untrusted_socket_rejected "${AGENT_SOCKET}" "the agent socket"
assert_untrusted_socket_rejected "${CONTROL_SOCKET}" "the control socket"

echo "==> Verifying cold-start daemon recovery"
cold_runs_before="$(job_runs)"
stop_app
stop_daemon
start_app
cold_runs_after="$(job_runs)"
if ((cold_runs_after <= cold_runs_before)); then
    echo "Cold-start recovery did not start the existing LaunchAgent" >&2
    echo "runs before=${cold_runs_before}, after=${cold_runs_after}" >&2
    exit 1
fi

echo "==> Verifying runtime daemon recovery"
app_pid="$(pgrep -x "${APP_NAME}" | awk 'NR == 1 { first = $0 } END { print first }')"
runtime_runs_before="$(job_runs)"
old_daemon_pid="$(job_pid)"
if [[ "${old_daemon_pid}" == "0" ]]; then
    echo "Could not capture the running daemon generation before recovery" >&2
    exit 1
fi
assert_daemon_owns_socket "${old_daemon_pid}" "${AGENT_SOCKET}"
assert_daemon_owns_socket "${old_daemon_pid}" "${CONTROL_SOCKET}"
/bin/launchctl stop "${SERVICE_LABEL}"
wait_for_job_restart "${runtime_runs_before}" "the running app to recover its daemon"
if ! kill -0 "${app_pid}" 2>/dev/null; then
    echo "Runtime recovery restarted the Floria app instead of only its daemon" >&2
    exit 1
fi
new_daemon_pid="$(job_pid)"
if [[ "${new_daemon_pid}" == "0" || "${new_daemon_pid}" == "${old_daemon_pid}" ]]; then
    echo "Runtime recovery did not replace daemon pid ${old_daemon_pid}" >&2
    exit 1
fi
wait_for_process_exit "${old_daemon_pid}" "the previous Floria daemon"

assert_daemon_owns_socket "${new_daemon_pid}" "${AGENT_SOCKET}"
assert_daemon_owns_socket "${new_daemon_pid}" "${CONTROL_SOCKET}"

new_agent_inode="$(socket_inode "${AGENT_SOCKET}")"
new_control_inode="$(socket_inode "${CONTROL_SOCKET}")"
if [[ -z "${new_agent_inode}" ]]; then
    echo "Agent socket is missing after daemon recovery" >&2
    exit 1
fi
if [[ -z "${new_control_inode}" ]]; then
    echo "Control socket is missing after daemon recovery" >&2
    exit 1
fi

# Give any delayed cleanup from the old generation a chance to run. The new daemon must retain
# both pathname identities and ownership throughout the handoff.
sleep 1
if [[ "$(job_pid)" != "${new_daemon_pid}" ||
    "$(socket_inode "${AGENT_SOCKET}")" != "${new_agent_inode}" ||
    "$(socket_inode "${CONTROL_SOCKET}")" != "${new_control_inode}" ]]; then
    echo "The recovered daemon generation changed during the handoff stability window" >&2
    exit 1
fi
assert_daemon_owns_socket "${new_daemon_pid}" "${AGENT_SOCKET}"
assert_daemon_owns_socket "${new_daemon_pid}" "${CONTROL_SOCKET}"

run_crash_read=1
if [[ -n "${FLORIA_SMOKE_MANAGED_READ_PATH:-}" ]]; then
    CRASH_FIXTURE_PATH="${FLORIA_SMOKE_MANAGED_READ_PATH}"
    if [[ ! -e "${CRASH_FIXTURE_PATH}" ]]; then
        echo "Managed read fixture does not exist: ${CRASH_FIXTURE_PATH}" >&2
        exit 1
    fi
elif codesign -dv --verbose=4 "${DAEMON_PATH}" 2>&1 |
    awk -F= '$1 == "TeamIdentifier" && $2 != "not set" { found = 1 } END { exit !found }'; then
    run_crash_read=0
    echo "==> Skipping interrupted-read fixture for the signed packaged helper"
    echo "    Pass FLORIA_SMOKE_MANAGED_READ_PATH to exercise an existing Managed file without changing Library data."
else
    echo "==> Preparing an isolated interrupted-read fixture"
    CRASH_FIXTURE_DIRECTORY="$(mktemp -d /private/tmp/floria-daemon-crash.XXXXXX)"
    CRASH_FIXTURE_PATH="${CRASH_FIXTURE_DIRECTORY}/managed-fixture"
    CRASH_FIXTURE_OWNED=1
    printf 'floria-daemon-crash-fixture\n' >"${CRASH_FIXTURE_PATH}"
    "${DAEMON_PATH}" protect "${CRASH_FIXTURE_PATH}" --config "${CONFIG_PATH}" >/dev/null
fi

if ((run_crash_read != 0)); then
    echo "==> Verifying an open read fails promptly after a daemon crash"

    if [[ -z "${CRASH_FIXTURE_DIRECTORY}" ]]; then
        CRASH_FIXTURE_DIRECTORY="$(mktemp -d /private/tmp/floria-daemon-crash.XXXXXX)"
    fi
    reader_ready="${CRASH_FIXTURE_DIRECTORY}/reader-ready"
    reader_continue="${CRASH_FIXTURE_DIRECTORY}/reader-continue"
    reader_result="${CRASH_FIXTURE_DIRECTORY}/reader-result"
/bin/zsh -c '
    zmodload zsh/system || exit 91
    fixture_path="$1"
    ready_path="$2"
    continue_path="$3"
    result_path="$4"

    exec 3<"${fixture_path}" || exit 92
    first_byte=""
    sysread -i 3 -s 1 first_byte
    first_status=$?
    print -r -- "${first_status}" >"${ready_path}"

    while [[ ! -e "${continue_path}" ]]; do
        sleep 0.01
    done

    second_byte=""
    sysread -i 3 -s 1 second_byte
    second_status=$?
    {
        print -r -- "second_status=${second_status}"
        print -r -- "second_length=${#second_byte}"
    } >"${result_path}"
' -- "${CRASH_FIXTURE_PATH}" "${reader_ready}" "${reader_continue}" "${reader_result}" &
CRASH_READER_PID=$!

wait_for_path "${reader_ready}" "the crash-test reader to open its Managed file"
first_status="$(<"${reader_ready}")"
if [[ "${first_status}" != "0" ]]; then
    echo "The crash-test reader could not read its first byte (status ${first_status})" >&2
    exit 1
fi

crash_runs_before="$(job_runs)"
crashed_daemon_pid="$(job_pid)"
if [[ "${crashed_daemon_pid}" == "0" ]]; then
    echo "Could not capture the daemon generation before SIGKILL" >&2
    exit 1
fi
/bin/kill -9 "${crashed_daemon_pid}"
wait_for_process_exit "${crashed_daemon_pid}" "the SIGKILLed Floria daemon"
touch "${reader_continue}"

if ! wait_for_path \
    "${reader_result}" \
    "the old file descriptor to fail after daemon SIGKILL" \
    "${READ_FAILURE_SECONDS}"; then
    echo "The old file descriptor remained blocked after daemon SIGKILL" >&2
    exit 1
fi
wait "${CRASH_READER_PID}"
CRASH_READER_PID=0

second_status="$(awk -F= '$1 == "second_status" { print $2 }' "${reader_result}")"
second_length="$(awk -F= '$1 == "second_length" { print $2 }' "${reader_result}")"
if [[ ! "${second_status}" =~ ^[0-9]+$ || "${second_status}" == "0" ]]; then
    echo "The old file descriptor unexpectedly completed its second read" >&2
    cat "${reader_result}" >&2
    exit 1
fi
if [[ "${second_length}" != "0" ]]; then
    echo "The old file descriptor returned plaintext after daemon SIGKILL" >&2
    cat "${reader_result}" >&2
    exit 1
fi

wait_for_job_restart "${crash_runs_before}" "launchd to replace the SIGKILLed daemon"
recovered_daemon_pid="$(job_pid)"
if [[ "${recovered_daemon_pid}" == "0" ||
    "${recovered_daemon_pid}" == "${crashed_daemon_pid}" ]]; then
    echo "SIGKILL recovery did not replace daemon pid ${crashed_daemon_pid}" >&2
    exit 1
fi
wait_for_doctor "the installation to recover after daemon SIGKILL"
echo "Old fd failed with status ${second_status}; daemon ${crashed_daemon_pid} recovered as ${recovered_daemon_pid}"
fi

echo "==> Verifying recovered installation health"
wait_for_doctor "the recovered Floria installation to become healthy"
"${DAEMON_PATH}" doctor --config "${CONFIG_PATH}"
echo "Floria installed-app smoke test passed"
