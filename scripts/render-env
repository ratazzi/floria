#!/usr/bin/env bash
# Example read handler: emit a dotenv snippet for <project> <env>.
# Protocol: stdin is empty; stdout is the file content; FLORIA_* context is in the env.
set -euo pipefail

project="${1:-unknown}"
env="${2:-unknown}"

cat <<EOF
# generated by floria for ${project}/${env}
# reader pid=${FLORIA_REQUEST_PID:-?} uid=${FLORIA_REQUEST_UID:-?}
APP_ENV=${env}
APP_PROJECT=${project}
DATABASE_URL=postgres://127.0.0.1:5432/${project}_${env}
API_TOKEN=demo-token-$(date +%s)
EOF
