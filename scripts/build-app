#!/bin/bash
set -euo pipefail

VERSION="$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/')"
BUILD_NUMBER="${BUILD_NUMBER:-$(date +%Y%m%d%H%M)}"
SIGN_IDENTITY="${SIGN_IDENTITY:--}"
FLORIA_SIGNING_TEAM_ID="${FLORIA_SIGNING_TEAM_ID:-}"
FLORIA_APP_PROVISIONING_PROFILE="${FLORIA_APP_PROVISIONING_PROFILE:-}"
PRODUCT_NAME="floria-menubar"
APP_NAME="Floria"
APP_BUNDLE="app/.build/${APP_NAME}.app"
APP_ENTITLEMENTS="app/Floria.entitlements"
SIGNED_APP_ENTITLEMENTS="app/.build/${APP_NAME}.signed.entitlements"

codesign_args=(--force --sign "${SIGN_IDENTITY}" --options runtime)
if [[ "${SIGN_IDENTITY}" != "-" ]]; then
    codesign_args+=(--timestamp)
fi

echo "==> Building ${APP_NAME}.app v${VERSION} (build ${BUILD_NUMBER})"
if [[ -n "${FLORIA_APP_PROVISIONING_PROFILE}" ]]; then
    if [[ "${SIGN_IDENTITY}" == "-" ]]; then
        echo "FLORIA_APP_PROVISIONING_PROFILE requires a non-ad-hoc SIGN_IDENTITY." >&2
        exit 1
    fi
    if [[ ! -f "${FLORIA_APP_PROVISIONING_PROFILE}" ]]; then
        echo "Provisioning profile does not exist: ${FLORIA_APP_PROVISIONING_PROFILE}" >&2
        exit 1
    fi
    FLORIA_SIGNING_TEAM_ID="${FLORIA_SIGNING_TEAM_ID}" \
        scripts/verify-cloudkit-signing \
        --profile "${FLORIA_APP_PROVISIONING_PROFILE}"
    mkdir -p "$(dirname "${SIGNED_APP_ENTITLEMENTS}")"
    cp "${APP_ENTITLEMENTS}" "${SIGNED_APP_ENTITLEMENTS}"
    /usr/libexec/PlistBuddy \
        -c "Add :com.apple.application-identifier string ${FLORIA_SIGNING_TEAM_ID}.floria.hola.ac" \
        "${SIGNED_APP_ENTITLEMENTS}"
    /usr/libexec/PlistBuddy \
        -c "Add :com.apple.developer.team-identifier string ${FLORIA_SIGNING_TEAM_ID}" \
        "${SIGNED_APP_ENTITLEMENTS}"
elif [[ "${SIGN_IDENTITY}" != "-" ]]; then
    echo "==> CloudKit disabled: set FLORIA_APP_PROVISIONING_PROFILE for a CloudKit-capable signed app"
else
    echo "==> CloudKit disabled in this ad-hoc development build"
fi
echo "==> Building Rust daemon"
if [[ "${SIGN_IDENTITY}" == "-" ]]; then
    FLORIA_INSECURE_DEVELOPMENT_BUILD=1 cargo build --release -p floria
elif [[ "${FLORIA_SIGNING_TEAM_ID}" =~ ^[A-Z0-9]{10}$ ]]; then
    FLORIA_SIGNING_TEAM_ID="${FLORIA_SIGNING_TEAM_ID}" cargo build --release -p floria
else
    echo "A signed build requires FLORIA_SIGNING_TEAM_ID (the 10-character Apple Team ID)." >&2
    exit 1
fi

echo "==> Building Swift app"
swift build --package-path app --configuration release --product "${PRODUCT_NAME}"
BIN_DIR="$(swift build --package-path app --configuration release --show-bin-path)"

echo "==> Packaging ${APP_BUNDLE}"
rm -rf "${APP_BUNDLE}"
mkdir -p "${APP_BUNDLE}/Contents/MacOS" "${APP_BUNDLE}/Contents/Resources"
cp "${BIN_DIR}/${PRODUCT_NAME}" "${APP_BUNDLE}/Contents/MacOS/${APP_NAME}"
cp target/release/floria "${APP_BUNDLE}/Contents/Resources/floria"
cp floria.toml "${APP_BUNDLE}/Contents/Resources/floria.toml"
cp app/Assets/AppIcon.icns "${APP_BUNDLE}/Contents/Resources/AppIcon.icns"
cp app/Assets/MenuBarTemplate.png "${APP_BUNDLE}/Contents/Resources/MenuBarTemplate.png"
cp app/Info.plist "${APP_BUNDLE}/Contents/Info.plist"
if [[ -n "${FLORIA_APP_PROVISIONING_PROFILE}" ]]; then
    cp "${FLORIA_APP_PROVISIONING_PROFILE}" \
        "${APP_BUNDLE}/Contents/embedded.provisionprofile"
fi
plutil -replace CFBundleShortVersionString -string "${VERSION}" "${APP_BUNDLE}/Contents/Info.plist"
plutil -replace CFBundleVersion -string "${BUILD_NUMBER}" "${APP_BUNDLE}/Contents/Info.plist"
chmod 0755 "${APP_BUNDLE}/Contents/MacOS/${APP_NAME}"
chmod 0755 "${APP_BUNDLE}/Contents/Resources/floria"
codesign "${codesign_args[@]}" \
    --identifier floria.hola.ac.daemon \
    --entitlements app/FloriaDaemon.entitlements \
    --library-constraint app/FloriaDaemonLibraryConstraint.plist \
    --enforce-constraint-validity \
    "${APP_BUNDLE}/Contents/Resources/floria"
codesign "${codesign_args[@]}" --identifier floria.hola.ac "${APP_BUNDLE}/Contents/MacOS/${APP_NAME}"
if [[ -n "${FLORIA_APP_PROVISIONING_PROFILE}" ]]; then
    codesign "${codesign_args[@]}" \
        --identifier floria.hola.ac \
        --entitlements "${SIGNED_APP_ENTITLEMENTS}" \
        "${APP_BUNDLE}"
else
    codesign "${codesign_args[@]}" --identifier floria.hola.ac "${APP_BUNDLE}"
fi
codesign --verify --deep --strict "${APP_BUNDLE}"
if [[ -n "${FLORIA_APP_PROVISIONING_PROFILE}" ]]; then
    FLORIA_SIGNING_TEAM_ID="${FLORIA_SIGNING_TEAM_ID}" \
        scripts/verify-cloudkit-signing --app "${APP_BUNDLE}"
    rm -f "${SIGNED_APP_ENTITLEMENTS}"
fi
# Hardened Runtime library validation can reject macFUSE's separately signed dylib before main().
# Execute the packaged daemon so every build catches that exact failure, not only signature syntax.
"${APP_BUNDLE}/Contents/Resources/floria" --version >/dev/null

echo "==> Built: ${APP_BUNDLE}"
